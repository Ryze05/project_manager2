generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectRole {
  OWNER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  memberships   ProjectMember[]
  createdTasks  Task[]          @relation("TaskCreator")
  assignedTasks Task[]          @relation("TaskAssignee")
  comments      Comment[]
  activities    Activity[]

  invitations     Invitation[] @relation("Invitee")
  sentInvitations Invitation[] @relation("Inviter")
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  members     ProjectMember[]
  tasks       Task[]
  labels      Label[]
  activities  Activity[]
  invitations Invitation[]
}

model ProjectMember {
  userId    String      @db.Uuid
  projectId String      @db.Uuid
  role      ProjectRole @default(MEMBER)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

// Invitacion pendiente a un usuario ya registrado. Solo existe mientras esta pendiente:
// aceptarla, rechazarla o cancelarla la borra (aceptar ademas crea la membresia).
model Invitation {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  userId      String   @db.Uuid
  invitedById String   @db.Uuid
  createdAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation("Invitee", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("Inviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// Las subtareas son tareas con parentId informado (un solo nivel, validado en el servicio).
model Task {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  // Orden manual dentro de la columna del tablero (solo tareas, no subtareas). Mayor = mas abajo.
  // Es un numero con huecos: soltar entre dos tarjetas toma el punto medio, sin renumerar.
  position    Float        @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  projectId  String  @db.Uuid
  creatorId  String  @db.Uuid
  assigneeId String? @db.Uuid
  parentId   String? @db.Uuid

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator  User      @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parent   Task?     @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]    @relation("Subtasks")
  comments Comment[]
  // Solo las tareas llevan etiquetas, no las subtareas (validado en el servicio).
  labels   Label[]

  @@index([projectId, status, position])
  @@index([assigneeId, dueDate])
  @@index([parentId])
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  content   String
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  taskId   String @db.Uuid
  authorId String @db.Uuid

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
}

// Etiquetas de un proyecto, sin color propio (el sistema de diseno solo tiene un acento).
// El nombre es unico dentro del proyecto; el servicio ademas lo compara sin distinguir mayusculas.
// La relacion con Task es muchos a muchos implicita: al borrar la etiqueta o la tarea
// desaparece solo la fila de union.
model Label {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())

  projectId String @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([projectId, name])
}

enum ActivityType {
  TASK_CREATED
  TASK_DELETED
  TITLE_CHANGED
  DESCRIPTION_CHANGED
  STATUS_CHANGED
  PRIORITY_CHANGED
  DUE_DATE_CHANGED
  ASSIGNEE_CHANGED
  LABEL_ADDED
  LABEL_REMOVED
  COMMENT_ADDED
  MEMBER_ADDED
  MEMBER_REMOVED
  MEMBER_PROMOTED
  MEMBER_DEMOTED
  MEMBER_LEFT
  INVITATION_ACCEPTED
}

// Historial del proyecto. Un evento por campo cambiado. taskId NO es clave foranea a
// proposito: el rastro de una tarea borrada tiene que sobrevivirla, por eso se guarda
// tambien su titulo (taskTitle). Solo desaparece al borrar el proyecto. `data` lleva
// los valores ya legibles (de/a), para que el historial no cambie si luego se renombra algo.
model Activity {
  id        String       @id @default(uuid()) @db.Uuid
  type      ActivityType
  createdAt DateTime     @default(now())

  projectId String  @db.Uuid
  actorId   String  @db.Uuid
  taskId    String? @db.Uuid
  taskTitle String?
  isSubtask Boolean @default(false)
  // Padre de la subtarea del evento (sin FK, como taskId): deja que el historial de la padre
  // incluya cuando se crea o se completa una subtarea suya.
  parentId  String? @db.Uuid
  data      Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([taskId, createdAt(sort: Desc)])
  @@index([parentId, createdAt(sort: Desc)])
}
